# ferrumd.env.example
# Environment file for ferrumd.service bearer token.
# Single-node SQLite only. No PostgreSQL. No production-ready claim.
#
# DO NOT commit real tokens to version control.
# Generate a secure token with: openssl rand -hex 32
#
# Usage:
#   1. Copy to /etc/ferrumgate/ferrumd.env
#   2. Replace REPLACE_WITH_GENERATED_TOKEN with the output of:
#      openssl rand -hex 32
#   3. Set permissions: chmod 600 /etc/ferrumgate/ferrumd.env
#   4. Reference from ferrumd.service via EnvironmentFile=-/etc/ferrumgate/ferrumd.env

FERRUMD_BEARER_TOKEN=fg_live_REPLACE_WITH_GENERATED_TOKEN

# ── Production-Required Controls (P0-1 / P0-7) ──
# All three must be enabled in production. They are optional for dev/nonprod
# testing, but omitting them in production makes the daemon fail closed.
# FERRUMD_LIFECYCLE_RECONCILIATION_ENABLED=true
# FERRUMD_APPROVAL_TIMEOUT_ENABLED=true
# FERRUMD_AUDIT_FAIL_CLOSED=true

# ── PDP Mode ──
# "static", "bundles", or "dual" (default). Dual preserves bundle-first/static-fallback behavior.
# FERRUMD_PDP_MODE=dual

# ── Approval Timeout Reconciliation ──
# FERRUMD_APPROVAL_TIMEOUT_ENABLED=false
# FERRUMD_APPROVAL_TIMEOUT_SECONDS=3600
# FERRUMD_APPROVAL_RECONCILIATION_INTERVAL_SECS=300

# ── HA Reconciler (Stale In-Flight Executions) ──
# FERRUMD_HA_RECONCILER_ENABLED=false
# FERRUMD_HA_RECONCILER_INTERVAL_SECS=60
# FERRUMD_HA_RECONCILER_STALE_THRESHOLD_SECS=1800
# FERRUMD_HA_RECONCILER_BATCH_SIZE=100

# ── Rate Limiting & Trusted Proxy ──
# Workload routes are protected by an outer pre-auth IP governor and, for
# scoped/oidc/agent auth modes, an inner AuthActor+IP governor. Monitoring
# routes bypass both. Leave FERRUMD_TRUSTED_PROXY_CIDRS unset or empty to
# bucket by immediate transport peer IP (safest default). X-Forwarded-For is
# ignored; only a single X-Real-IP header from a trusted immediate peer is
# honored.
# FERRUMD_TRUSTED_PROXY_CIDRS=
# FERRUMD_RATE_LIMIT_PER_SECOND=2
# FERRUMD_RATE_LIMIT_BURST=50
# FERRUMD_PRE_AUTH_RATE_LIMIT_PER_SECOND=2
# FERRUMD_PRE_AUTH_RATE_LIMIT_BURST=50

# ── Nonce Cache (Agent Auth Replay Protection) ──
# "auto" (default), "memory", or "postgres". Auto selects Postgres for PostgreSQL stores.
# FERRUMD_NONCE_CACHE_BACKEND=auto
# 0 derives TTL from agent_clock_skew_secs*2 (min 60s).
# FERRUMD_NONCE_CACHE_TTL_SECS=0
# FERRUMD_NONCE_CACHE_MAX_ENTRIES=10000

# ── MFA Environment Variables ──
# Uncomment and configure to enable TOTP credential storage.
# FERRUMD_MFA_SECRET_KEY must be exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
#
# FERRUMD_MFA_SECRET_KEY=REPLACE_WITH_GENERATED_KEY
# FERRUMD_MFA_TOTP_ISSUER=FerrumGate
# FERRUMD_APPROVAL_MFA_REQUIRED=false
# FERRUMD_MFA_LOCKOUT_MAX_ATTEMPTS=5
# FERRUMD_MFA_LOCKOUT_DURATION_SECS=900
# Lockout settings apply to both per-factor and per-agent MFA lockout.

# ── OIDC Environment Variables (Phase 4.4) ──
# Uncomment and configure when auth_mode = "oidc".
# These override values from the TOML config file.
#
# FERRUMD_OIDC_ISSUER=https://your-issuer.example.com
# FERRUMD_OIDC_AUDIENCES=ferrumgate
# FERRUMD_OIDC_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
# FERRUMD_OIDC_JWKS_CACHE_TTL_SECS=300
# FERRUMD_OIDC_ACTOR_ID_CLAIM=sub
# FERRUMD_OIDC_ROLE_SOURCE_CLAIM=groups
# FERRUMD_OIDC_REQUIRE_EMAIL_VERIFIED=true
# FERRUMD_OIDC_ALLOWED_ALGORITHMS=RS256,ES256,EdDSA
# FERRUMD_OIDC_ROLE_MAPPINGS=fg-admins=admin,fg-operators=operator

# ── WORM-Compatible Audit Bundle Sink (optional) ──
# Requires ferrumd to be built with --features worm-sink (implies s3).
# Disabled by default. The operator must provision the bucket and enable
# S3 Object Lock; the adapter does not create buckets or manage IAM.
#
# FERRUMD_AUDIT_WORM_SINK_ENABLED=false
# FERRUMD_AUDIT_WORM_SINK_BUCKET=my-ferrumgate-audit-bucket
# FERRUMD_AUDIT_WORM_SINK_PREFIX=audit-worm
# FERRUMD_AUDIT_WORM_SINK_OBJECT_LOCK_MODE=governance
# FERRUMD_AUDIT_WORM_SINK_RETENTION_DAYS=30
# FERRUMD_AUDIT_WORM_SINK_LEGAL_HOLD=false
# FERRUMD_AUDIT_WORM_SINK_EXPORT_INTERVAL_SECS=300
# FERRUMD_AUDIT_WORM_SINK_BATCH_LIMIT=1000
# FERRUMD_AUDIT_WORM_SINK_LIVE=false
# FERRUMD_AUDIT_WORM_SINK_ENDPOINT_URL=http://localhost:9000
# FERRUMD_AUDIT_WORM_SINK_REGION=us-east-1
# FERRUMD_AUDIT_WORM_SINK_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# FERRUMD_AUDIT_WORM_SINK_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY

# ── GCS Adapter (optional) ──
# Requires ferrumd to be built with --features gcs.
# Disabled by default. Live SDK integration is a declared seam; shape-only
# validation runs when live=false. Azure Blob is deferred.
#
# FERRUMD_GCS_ALLOWED_BUCKET=my-ferrumgate-gcs-bucket
# FERRUMD_GCS_ENDPOINT_URL=https://storage.googleapis.com
# FERRUMD_GCS_PROJECT_ID=my-gcp-project
# FERRUMD_GCS_CREDENTIALS_PATH=/etc/ferrumgate/gcs-service-account.json
# FERRUMD_GCS_LIVE=false

# ── HTTP Egress Adapter (optional) ──
# Disabled when absent or empty. Only exact DNS host names are permitted.
# Overrides server.http_egress.allowed_hosts from the TOML config file.
# FERRUMD_HTTP_EGRESS_ALLOWED_HOSTS=api.example.com,webhook.example.com
